# ─── LLM Mode ────────────────────────────────────────────────────────────────
# Choose "openai", "gemini", or "local"
LLM_MODE=openai

# ─── OpenAI settings (used when LLM_MODE=openai) ─────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── Gemini settings (used when LLM_MODE=gemini) ─────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ─── Local LLM settings (used when LLM_MODE=local) ───────────────────────────
# 1. Download a GGUF model
# 2. Place the file in a "models/" folder (already in .gitignore)
# 3. Install ollama (https://ollama.com/docs/installation) and run "ollama serve" in the background
# 4. Run "ollama create gemma4 -f Modelfile" to load the model into ollama
# 5. Run "ollama serve" to start the ollama server

OLLAMA_MODEL_PATH=gemma4

# Number of model layers to offload to GPU (-1 = all layers)
N_GPU_LAYERS=-1

# Context window size in tokens
N_CTX=8192
