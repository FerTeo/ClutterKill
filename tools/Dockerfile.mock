# tools/Dockerfile.mock
# ──────────────────────────────────────────────────────────────────────────
# Imagine Docker pentru rularea tools/mock_generator.py.
#
# Utilizare (din rădăcina repo-ului):
#   docker compose run --rm mock-generator
#
# Fișierele generate aterizează în tests/mock_data/ pe mașina host
# prin volume mount — nu rămân blocate în container.
# ──────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

# Instalează dependențele de sistem necesare pentru Pillow
# (libjpeg și libwebp lipsesc din imaginile slim by default)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libjpeg-dev \
    libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Instalează pachetele Python necesare
# Versiunile sunt fixate pentru reproducibilitate
RUN pip install --no-cache-dir \
    "fpdf2==2.8.3" \
    "Pillow==11.2.1" \
    "faker==37.1.0"

# Copiază doar scriptul (nu tot repo-ul)
COPY tools/mock_generator.py tools/mock_generator.py

# Directorul de output — va fi montat ca volum de pe host
RUN mkdir -p tests/mock_data

# Rulează generatorul cu parametrii impliciți (510 fișiere)
CMD ["python", "tools/mock_generator.py", "--out-dir", "tests/mock_data"]
